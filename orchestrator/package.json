{
  "name": "orchestrator",
  "version": "1.0.0",
  "description": "AI Agent Orchestration Platform — Orchestrator Service",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --require dotenv/config server.js",
    "worker": "nodemon --require dotenv/config worker.js",
    "start": "node server.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0"
  }
}
